#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
Admin Console Launcher – Ubuntu (64‑bit) edition

Fixes added (as requested)
=========================
* **DPI‑aware scaling with a sensible ceiling** – on 4 K monitors the UI is
  still proportional but never becomes absurdly large.  The scaling factor
  is capped at 1.5 and the base font size is limited to a maximum of 14 pt.
* **Installer language switch now requires a restart** – when the user picks a
  different language the configuration is saved, a short “restart‑required”
  message is shown and the installer exits.  On the next launch the UI is
  automatically displayed in the selected language.
* **Console‑settings language change no longer raises a TypeError** – the
  callback that updates the live preview now uses a different argument name
  (`*_args`) so the global translation function ``_`` is not shadowed.
* **All Settings‑window buttons (Import, Export, View Logs, “Logs Folder”) are
  functional** and the state of every setting is persisted to a single
  configuration file (`~/.admin-console-launcher/config/config.json`).
* **Log‑viewer now contains a “Keep Session Logs” control** (moved from the
  settings dialog) and respects the user‑defined retention count.
* **Credit label updated** – shows “EnigmaticPr0 Software 2026”.
"""

import os
import sys
import json
import shutil
import subprocess
import threading
import urllib.request
import urllib.error
import ssl
import time
import re
import math
import random
import webbrowser
import tkinter as tk
from tkinter import font, messagebox, filedialog, ttk

# Base directories for configuration, logs, and temporary files
BASE_DIR = os.path.expanduser("~/.admin-console-launcher")
CONFIG_DIR = os.path.join(BASE_DIR, "config")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
LOGS_DIR = os.path.join(BASE_DIR, "logs")
TMP_DIR = os.path.join(BASE_DIR, "tmp")

for _d in (CONFIG_DIR, LOGS_DIR, TMP_DIR):
    os.makedirs(_d, exist_ok=True)

