        self.auto_lbl.pack(side="left", padx=5)
        self.cancel_auto_btn = tk.Button(
            self.auto_frame, text=_("cancel_label"), command=self.cancel_auto_connect
        )
        self.cancel_auto_btn.pack(side="left", padx=5)

        self.bottom_frame = tk.Frame(self.root)
        self.bottom_frame.pack(fill="x", padx=30, pady=(10, 25))

        self.credit_label = tk.Label(
            self.bottom_frame,
            text="EnigmaticPr0 Software 2026",
            font=("DejaVu Sans", 8, "italic"),
        )
        self.credit_label.pack(side="left")

        self.quit_btn = tk.Button(
            self.bottom_frame,
            text=_("quit_label"),
            width=14,
            padx=10,
            pady=6,
            command=self.on_close,
        )
        self.quit_btn.pack(side="right")

        # Center window on screen
        self.root.update_idletasks()
        w = self.root.winfo_width()
        h = self.root.winfo_height()
        x = (self.root.winfo_screenwidth() // 2) - (w // 2)
        y = (self.root.winfo_screenheight() // 2) - (h // 2)
        self.root.geometry(f"+{x}+{y}")

        self.root.bind("<Configure>", self.on_resize)
        self.apply_theme(self.current_theme)
        self.setup_hotkeys()

        self.running = True
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

        self.monitor_thread = threading.Thread(
            target=self.monitor_connection, daemon=True
        )
        self.monitor_thread.start()

    # Log a message (in‑memory and to session file)
    def log(self, message: str) -> None:
        timestamp = time.strftime("[%H:%M:%S]")
        line = f"{timestamp} {message}"
        self.logs.append(line)
        if len(self.logs) > 300:
            self.logs.pop(0)
        try:
            self.session_log_file.write(line + "\n")
            self.session_log_file.flush()
        except Exception:
            pass

    # Keep only the most recent N session logs
    def _enforce_log_retention(self) -> None:
        keep = max(1, self.cfg.get("keep_logs", 10))
        try:
            files = sorted(
                [f for f in os.listdir(LOGS_DIR)
                 if f.startswith("session_") and f.endswith(".log")],
                key=lambda x: os.path.getmtime(os.path.join(LOGS_DIR, x)),
                reverse=True,
            )
            for old in files[keep:]:
                try:
                    os.remove(os.path.join(LOGS_DIR, old))
                except Exception:
                    pass
        except Exception:
            pass

    # Hover effect helper
    def apply_hover_effects(self, widget: tk.Widget, normal_bg: str, hover_bg: str) -> None:
        widget.unbind("<Enter>")
        widget.unbind("<Leave>")
        widget.bind(
            "<Enter>",
            lambda e: widget.configure(bg=hover_bg)
            if str(widget["state"]) != "disabled"
            else None,
        )
        widget.bind(
            "<Leave>",
            lambda e: widget.configure(bg=normal_bg)
            if str(widget["state"]) != "disabled"
            else None,
        )

    # Redraw Aero background on resize
    def on_resize(self, event: tk.Event) -> None:
        if event.widget == self.root and self.current_theme == "Frutiger Aero":
            self.draw_aero_background()

    # Build target URL from configuration
    def get_target_url(self) -> str:
        proto = self.cfg.get("protocol", "http")
        return f"{proto}://{self.cfg['ip']}/{self.cfg['jnlp']}"

    # Build connect button label
    def get_connect_text(self) -> str:
        t = self.THEMES.get(self.current_theme, self.THEMES["Mint"])
        pattern = t.get("connect_label", _("connect_label"))
        return pattern.format(url=self.get_target_url())

    # Keyboard shortcuts
    def setup_hotkeys(self) -> None:
        def handle_key(action, event):
            if isinstance(event.widget, tk.Entry):
                return
            action()

        self.root.bind("<Return>", lambda e: handle_key(self.launch_javaws, e))
        self.root.bind("<Escape>", lambda e: handle_key(self.on_close, e))
        self.root.bind("<F5>", lambda e: handle_key(self.force_network_check, e))
        self.root.bind("<r>", lambda e: handle_key(self.force_network_check, e))
        self.root.bind("<R>", lambda e: handle_key(self.force_network_check, e))
        self.root.bind("<space>", lambda e: handle_key(self.cancel_auto_connect, e))

    # Manual network refresh
    def force_network_check(self) -> None:
        self.log("Manual network refresh triggered.")
        threading.Thread(target=self._check_network_once, daemon=True).start()

    # Theme selection
    def select_theme(self, theme_key: str) -> None:
        self.cfg["theme"] = theme_key
        save_config(self.cfg)
        self.log(f"Theme changed to {theme_key}")
        self.apply_theme(theme_key)

    # Apply theme and refresh translatable UI texts
    def apply_theme(self, theme_key: str) -> None:
        self.current_theme = theme_key if theme_key in self.THEMES else "Mint"
        t = self.THEMES[self.current_theme]

        status_font = font.Font(family=t["font"], size=11, weight="bold")
        button_font = font.Font(family=t["font"], size=12, weight="bold")
        quit_font = font.Font(family=t["font"], size=10)
        sub_font = font.Font(family=t["font"], size=10)
        credit_font = font.Font(family=t["font"], size=8, slant="italic")

        self.root.configure(bg=t["bg"])

        if self.current_theme == "Frutiger Aero":
            self.bubble_canvas.place(x=0, y=0, relwidth=1, relheight=1)
            self.bubble_canvas.configure(bg=t["bg"])
            self.bubble_canvas.lower(self.root)
            self.init_bubbles()
            if not self.bubble_anim_job:
                self.animate_bubbles()
        else:
            if self.bubble_anim_job:
                try:
                    self.root.after_cancel(self.bubble_anim_job)
                except Exception:
                    pass
                self.bubble_anim_job = None
            self.bubble_canvas.place_forget()

        for frame in (
            self.top_frame,
            self.header_controls,
            self.center_frame,
            self.auto_frame,
            self.bottom_frame,
        ):
            frame.configure(bg=t["bg"])

        self.status_label.configure(
            font=status_font,
            bg=t["bg"],
            relief=t.get("status_relief", "flat"),
            bd=t.get("status_bd", 0),
        )
        if self.status_text:
            fg_color = t["conn_color"] if self.is_connected else t["unconn_color"]
            self.status_label.configure(text=self.status_text, fg=fg_color)
        else:
            self.status_label.configure(fg=t["status_dim"])

        btn_sec_kwargs = {
            "font": sub_font,
            "bg": t["btn_sec_bg"],
            "fg": t["btn_sec_fg"],
            "activebackground": t["btn_sec_active_bg"],
            "activeforeground": t["btn_sec_active_fg"],
            "relief": t["relief"],
            "bd": max(1, t["bd"]),
        }

        # Refresh translatable texts
        self.settings_btn.configure(text=_("settings_label"))
        self.theme_mb.configure(text="Theme ▾")
        self.cancel_auto_btn.configure(text=_("cancel_label"))
        self.auto_lbl.configure(text="")
        self.connect_btn.configure(
            text=self.get_connect_text(),
            font=button_font,
            bg=t["btn_main_bg"],
            fg=t["btn_main_fg"],
            activebackground=t["btn_main_active_bg"],
            activeforeground=t["btn_main_active_fg"],
            relief=t["relief"],
            bd=t["bd"],
        )
        self.apply_hover_effects(self.connect_btn, t["btn_main_bg"], t["btn_main_active_bg"])

        self.quit_btn.configure(
            text=_("quit_label"),
            font=quit_font,
            bg=t["btn_sec_bg"],
            fg=t["btn_sec_fg"],
            activebackground=t["btn_sec_active_bg"],
            activeforeground=t["btn_sec_active_fg"],
            relief=t["relief"],
            bd=t["bd"],
        )
        self.apply_hover_effects(self.quit_btn, t["btn_sec_bg"], t["btn_sec_active_bg"])

        self.credit_label.configure(font=credit_font, bg=t["bg"], fg=t["text"])

        self.settings_btn.configure(**btn_sec_kwargs, padx=8, pady=3)
        self.theme_mb.configure(**btn_sec_kwargs, padx=10, pady=3)
        self.cancel_auto_btn.configure(**btn_sec_kwargs, padx=6, pady=2)
        self.theme_menu.configure(
            font=sub_font,
            bg=t["btn_sec_bg"],
            fg=t["btn_sec_fg"],
            activebackground=t["btn_sec_active_bg"],
            activeforeground=t["btn_sec_active_fg"],
        )
        self.auto_lbl.configure(font=sub_font, bg=t["bg"], fg=t["text"])

    # Draw Aero background (sky, water, aurora)
    def draw_aero_background(self) -> None:
        if not hasattr(self, "bubble_canvas") or not hasattr(self, "aurora_phase"):
            return

        self.bubble_canvas.delete("aero_bg")
        w = max(self.root.winfo_width(), 740)
        h = max(self.root.winfo_height(), 400)

        sky_colors = ["#00325B", "#0D518A", "#1A6BB0", "#2E8AD6", "#50AAEE", "#8AD1FF"]
        band_h = h * 0.72 / len(sky_colors)
        for i, col in enumerate(sky_colors):
            y1 = i * band_h
            y2 = (i + 1) * band_h + 1
            self.bubble_canvas.create_rectangle(0, y1, w, y2, fill=col, outline="", tags="aero_bg")

        water_colors = ["#32B67A", "#18A585", "#0E838F", "#085773", "#04324B"]
        horizon_y = h * 0.68
        w_band_h = (h - horizon_y) / len(water_colors)
        for i, col in enumerate(water_colors):
            y1 = horizon_y + (i * w_band_h)
            y2 = horizon_y + ((i + 1) * w_band_h) + 1
            self.bubble_canvas.create_rectangle(0, y1, w, y2, fill=col, outline="", tags="aero_bg")

        sin_y = math.sin(self.aurora_phase) * 15
        cos_y = math.cos(self.aurora_phase * 0.8) * 12

        points = [
            -20, h * 0.55 + sin_y,
            w * 0.35, h * 0.3 + cos_y,
            w * 0.7, h * 0.5 - sin_y,
            w + 20, h * 0.25 + cos_y,
            w + 20, h * 0.72,
            -20, h * 0.72,
        ]
        self.bubble_canvas.create_polygon(points, fill="#3AE3FF", outline="", smooth=True, tags="aero_bg")

        inner_points = [
            -20, h * 0.5 + sin_y,
            w * 0.4, h * 0.25 + cos_y,
            w * 0.75, h * 0.45 - sin_y,
            w + 20, h * 0.2 + cos_y,
            w + 20, h * 0.62,
            -20, h * 0.62,
        ]
        self.bubble_canvas.create_polygon(inner_points, fill="#A2F2FF", outline="", smooth=True, tags="aero_bg")

        self.bubble_canvas.tag_lower("aero_bg")

    # Initialize bubbles and orbs for Aero animation
    def init_bubbles(self) -> None:
        self.draw_aero_background()
        self.bubble_canvas.delete("aero_obj")
        self.bubbles = []
        self.whimsey_orbs = []

        w = max(self.root.winfo_width(), 740)
        h = max(self.root.winfo_height(), 400)

        for _ in range(15):
            bx = random.randint(20, max(21, w - 20))
            by = random.randint(20, h + 60)
            br = random.randint(14, 38)
            bspeed = random.uniform(0.7, 1.8)

            b_shadow = self.bubble_canvas.create_oval(
                bx - br - 2, by - br - 2, bx + br + 2, by + br + 2,
                outline="#023059", width=1, fill="", tags="aero_obj",
            )
            b_rim = self.bubble_canvas.create_oval(
                bx - br, by - br, bx + br, by + br,
                outline="#FFFFFF", width=2, fill="#0B6BAA", tags="aero_obj",
            )
            b_inner = self.bubble_canvas.create_oval(
                bx - br + 3, by - br + 3, bx + br - 3, by + br - 3,
                outline="#72E3FF", width=1, fill="", tags="aero_obj",
            )
            b_glint1 = self.bubble_canvas.create_oval(
                bx - br * 0.6, by - br * 0.75, bx + br * 0.2, by - br * 0.2,
                outline="", fill="#FFFFFF", tags="aero_obj",
            )
            b_glint2 = self.bubble_canvas.create_oval(
                bx - br * 0.3, by + br * 0.3, bx + br * 0.5, by + br * 0.6,
                outline="", fill="#DDF7FF", tags="aero_obj",
            )
            self.bubbles.append(
                {
                    "shadow": b_shadow,
                    "rim": b_rim,
                    "inner": b_inner,
                    "glint1": b_glint1,
                    "glint2": b_glint2,
                    "x": bx,
                    "y": by,
                    "r": br,
                    "speed": bspeed,
                    "drift": random.uniform(-0.6, 0.6),
                }
            )

        for _ in range(12):
            mx = random.randint(20, max(21, w - 20))
            my = random.randint(10, h + 20)
            mr = random.randint(2, 5)
            mobj = self.bubble_canvas.create_oval(
                mx - mr, my - mr, mx + mr, my + mr,
                outline="", fill="#FFFFFF", tags="aero_obj",
            )
            self.whimsey_orbs.append(
                {
                    "id": mobj,
                    "x": mx,
                    "y": my,
                    "r": mr,
                    "speed": random.uniform(0.3, 0.9),
                    "phase": random.uniform(0, math.pi * 2),
                }
            )

    # Animate bubbles and orbs
    def animate_bubbles(self) -> None:
        if not getattr(self, "running", True) or self.current_theme != "Frutiger Aero":
            return

        w = self.root.winfo_width() or 740
        h = self.root.winfo_height() or 400

        self.aurora_phase += 0.03
        self.draw_aero_background()

        for b in self.bubbles:
            b["y"] -= b["speed"]
            b["x"] += b["drift"] + math.sin(b["y"] * 0.02) * 0.5
            if b["y"] + b["r"] < -10:
                b["y"] = h + b["r"] + random.randint(10, 50)
                b["x"] = random.randint(20, max(21, w - 20))

            bx, by, br = b["x"], b["y"], b["r"]
            self.bubble_canvas.coords(b["shadow"], bx - br - 2, by - br - 2, bx + br + 2, by + br + 2)
            self.bubble_canvas.coords(b["rim"], bx - br, by - br, bx + br, by + br)
            self.bubble_canvas.coords(b["inner"], bx - br + 3, by - br + 3, bx + br - 3, by + br - 3)
            self.bubble_canvas.coords(b["glint1"], bx - br * 0.6, by - br * 0.75, bx + br * 0.2, by - br * 0.2)
            self.bubble_canvas.coords(b["glint2"], bx - br * 0.3, by + br * 0.3, bx + br * 0.5, by + br * 0.6)

        for m in self.whimsey_orbs:
            m["y"] -= m["speed"]
            m["phase"] += 0.06
            m["x"] += math.sin(m["phase"]) * 0.8
            if m["y"] < -5:
                m["y"] = h + 15
                m["x"] = random.randint(20, max(21, w - 20))
            self.bubble_canvas.coords(
                m["id"],
                m["x"] - m["r"], m["y"] - m["r"], m["x"] + m["r"], m["y"] + m["r"],
            )

        self.bubble_anim_job = self.root.after(35, self.animate_bubbles)

    # Single network check (ping then HTTP)
    def _check_network_once(self) -> None:
        connected = False
        latency_ms = None
        proto = self.cfg.get("protocol", "http")

        # Ping test
        try:
            res = subprocess.run(
                ["ping", "-c", "1", "-W", "2", self.cfg["ip"]],
                capture_output=True,
                text=True,
                timeout=2.5,
            )
            if res.returncode == 0:
                connected = True
                match = re.search(r"time=([\d\.]+)\s*ms", res.stdout)
                if match:
                    latency_ms = float(match.group(1))
        except Exception:
            pass

        # HTTP fallback
        if not connected:
            try:
                url = f"{proto}://{self.cfg['ip']}"
                req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
                ctx = ssl.create_default_context()
                ctx.check_hostname = False
                ctx.verify_mode = ssl.CERT_NONE

                t0 = time.time()
                with urllib.request.urlopen(req, timeout=2.0, context=ctx) as response:
                    if response.status in (200, 301, 302, 401, 403):
                        connected = True
                        latency_ms = round((time.time() - t0) * 1000, 1)
            except Exception:
                pass

        prev_connected = self.is_connected
        self.is_connected = connected

        if connected:
            self.has_connected_once = True

        # Track disconnection while Java WebStart runs
        if self.ows_process and self.ows_process.poll() is None:
            if not connected:
                if self.disconnect_start_time is None:
                    self.disconnect_start_time = time.time()
                else:
                    elapsed = time.time() - self.disconnect_start_time
                    if elapsed >= 10 and not self.notification_sent:
                        send_desktop_notification(
                            _("network_disconnected").split(":")[0],
                            _("network_disconnected").format(ip=self.cfg["ip"]),
                        )
                        self.notification_sent = True
            else:
                self.disconnect_start_time = None
                self.notification_sent = False

        if getattr(self, "running", False):
            t = self.THEMES.get(self.current_theme, self.THEMES["Mint"])
            if connected:
                lat_str = f" ({latency_ms:.1f} ms)" if latency_ms is not None else ""
                self.status_text = _("cable_connected").format(lat=lat_str)
                fg_color = t["conn_color"]
                if not prev_connected:
                    self.log(f"Connection established to {self.cfg['ip']}{lat_str}.")
            else:
                self.status_text = _("cable_unconnected")
                fg_color = t["unconn_color"]
                if prev_connected:
                    self.log(f"Connection lost to {self.cfg['ip']}.")
                    self.auto_cancel = False

            self.root.after(
                0,
                lambda txt=self.status_text, fg=fg_color: self.status_label.config(
                    text=txt, fg=fg
                )
                if getattr(self, "running", False)
                else None,
            )

            if (
                connected
                and not prev_connected
                and self.cfg["auto_launch"]
                and not self.auto_cancel
                and not self.is_launching
            ):
                self.root.after(0, self.start_auto_countdown)

    # Continuous network monitoring thread
    def monitor_connection(self) -> None:
        while getattr(self, "running", True):
            self._check_network_once()
            time.sleep(2.0)

    # Start auto‑connect countdown
    def start_auto_countdown(self) -> None:
        self.countdown_val = 3
        self.auto_frame.pack(pady=5)
        self.tick_countdown()

    # Countdown tick
    def tick_countdown(self) -> None:
        if not self.is_connected or self.auto_cancel or self.is_launching:
            self.auto_frame.pack_forget()
            return
        if self.countdown_val > 0:
            self.auto_lbl.configure(
                text=_("auto_connecting_in").format(sec=self.countdown_val)
            )
            self.countdown_val -= 1
            self.countdown_timer = self.root.after(1000, self.tick_countdown)
        else:
            self.auto_frame.pack_forget()
            self.launch_javaws()

    # Cancel auto‑connect
    def cancel_auto_connect(self) -> None:
        self.auto_cancel = True
        if self.countdown_timer:
            try:
                self.root.after_cancel(self.countdown_timer)
            except Exception:
                pass
            self.countdown_timer = None
        self.auto_frame.pack_forget()
        self.log(_("cancel_label"))

    # Open log viewer with “Keep Session Logs” control
    def open_log_viewer(self) -> None:
        t = self.THEMES.get(self.current_theme, self.THEMES["Mint"])
        win = tk.Toplevel(self.root)
        win.title(_("log_window"))
        win.configure(bg=t["bg"])
        win.transient(self.root)
        win.grab_set()

        txt_bg = "#ffffff" if self.current_theme == "Windows 98" else "#1e1e1e"
        txt_fg = "#000000" if self.current_theme == "Windows 98" else "#d3dae3"
        txt_relief = "sunken" if self.current_theme in ("Windows 98", "Frutiger Aero") else "flat"
        txt_bd = 2 if self.current_theme == "Windows 98" else 1

        txt = tk.Text(
            win,
            bg=txt_bg,
            fg=txt_fg,
            font=("Monospace", 9),
            wrap="none",
            width=80,
            height=20,
            relief=txt_relief,
            bd=txt_bd,
        )
        txt.pack(fill="both", expand=True, padx=12, pady=12)

        try:
            with open(self.session_log_path, "r", encoding="utf-8") as f:
                content = f.read()
        except Exception:
            content = "\n".join(self.logs)

        txt.insert("1.0", content)
        txt.configure(state="disabled")

        # Keep Session Logs control
        keep_frame = tk.Frame(win, bg=t["bg"])
        keep_frame.pack(fill="x", pady=(0, 12), padx=12)

        ttk.Label(keep_frame, text="Keep Session Logs:",
                  background=t["bg"], foreground=t["text"]).pack(side="left")
        keep_var = tk.IntVar(value=self.cfg.get("keep_logs", 10))
        keep_spin = ttk.Spinbox(
            keep_frame, from_=1, to=100, textvariable=keep_var, width=5
        )
        keep_spin.pack(side="left", padx=5)

        def on_keep_change(*_):
            self.cfg["keep_logs"] = max(1, keep_var.get())
            save_config(self.cfg)
            self._enforce_log_retention()

        keep_var.trace_add("write", on_keep_change)

        def close_logs():
            try:
                win.grab_release()
                win.destroy()
            except Exception:
                pass

        win.protocol("WM_DELETE_WINDOW", close_logs)

        close_btn = tk.Button(
            win,
            text=_("close_btn"),
            command=close_logs,
            bg=t["btn_sec_bg"],
            fg=t["btn_sec_fg"],
            activebackground=t["btn_sec_active_bg"],
            activeforeground=t["btn_sec_active_fg"],
            relief=t["relief"],
            bd=max(1, t["bd"]),
            padx=12,
            pady=4,
            cursor="hand2",
        )
        close_btn.pack(pady=(0, 12))
        self.apply_hover_effects(close_btn, t["btn_sec_bg"], t["btn_sec_active_bg"])

        win.update_idletasks()
        rx = self.root.winfo_x() + (self.root.winfo_width() // 2) - (win.winfo_width() // 2)
        ry = self.root.winfo_y() + (self.root.winfo_height() // 2) - (win.winfo_height() // 2)
        win.geometry(f"+{rx}+{ry}")

    # Export configuration to a user‑chosen file
    def export_config(self) -> None:
        file_path = filedialog.asksaveasfilename(
            defaultextension=".json",
            filetypes=[("JSON Files", "*.json")],
            title=_("export_btn"),
        )
        if file_path:
            try:
                with open(file_path, "w") as f:
                    json.dump(self.cfg, f, indent=2)
                messagebox.showinfo(_("export_btn"), f"{_('export_btn')}:\n{file_path}")
            except Exception as e:
                messagebox.showerror(_("install_failed"), str(e))

    # Import configuration from a user‑chosen file
    def import_config(self) -> bool:
        file_path = filedialog.askopenfilename(
            filetypes=[("JSON Files", "*.json")],
            title=_("import_btn"),
        )
        if file_path:
            try:
                with open(file_path, "r") as f:
                    imported = json.load(f)
                if isinstance(imported, dict):
                    self.cfg.update(imported)
                    save_config(self.cfg)
                    self.connect_btn.configure(text=self.get_connect_text())
                    self.apply_theme(self.cfg.get("theme", self.current_theme))
                    messagebox.showinfo(_("import_btn"), _("import_btn"))
                    return True
            except Exception as e:
                messagebox.showerror(_("install_failed"), str(e))
        return False

    # Settings dialog (live preview, persistence, logging control)
    def open_settings(self) -> None:
        t = self.THEMES.get(self.current_theme, self.THEMES["Mint"])
        win = tk.Toplevel(self.root)
        win.title(_("settings_window"))
        win.configure(bg=t["bg"])
        win.transient(self.root)
        win.grab_set()

        old_cfg = self.cfg.copy()
        lbl_font = font.Font(family=t["font"], size=10, weight="bold")
        entry_font = font.Font(family=t["font"], size=10)

        proto_var = tk.StringVar(value=self.cfg.get("protocol", "http"))
        ip_var = tk.StringVar(value=self.cfg.get("ip", "192.168.1.200"))
        jnlp_var = tk.StringVar(value=self.cfg.get("jnlp", "admin.jnlp"))
        auto_var = tk.BooleanVar(value=self.cfg.get("auto_launch", False))
        lang_var = tk.StringVar(value=self.cfg.get("lang", "en"))

        def update_live_preview(*_args):
            self.cfg["protocol"] = proto_var.get()
            self.cfg["ip"] = ip_var.get().strip() or "192.168.1.200"
            self.cfg["jnlp"] = jnlp_var.get().strip() or "admin.jnlp"
            self.cfg["lang"] = lang_var.get()
            if not self.is_launching:
                self.connect_btn.configure(text=self.get_connect_text())
                self.settings_btn.configure(text=_("settings_label"))
                self.quit_btn.configure(text=_("quit_label"))
                self.cancel_auto_btn.configure(text=_("cancel_label"))
                self.auto_lbl.configure(text="")

        for var in (proto_var, ip_var, jnlp_var, lang_var):
            var.trace_add("write", update_live_preview)

        entry_relief = "sunken" if self.current_theme in ("Windows 98", "Frutiger Aero") else "flat"
        entry_bd = 2 if self.current_theme == "Windows 98" else 1

        ttk_style = ttk.Style()
        ttk_style.configure("TLabel", background=t["bg"], foreground=t["text"], font=lbl_font)
        ttk_style.configure("TEntry", font=entry_font)

        row = 0
        ttk.Label(win, text=_("protocol_label")).grid(row=row, column=0, sticky="e", padx=10, pady=8)
        proto_frame = ttk.Frame(win)
        proto_frame.grid(row=row, column=1, sticky="w", padx=10, pady=8)
        ttk.Radiobutton(proto_frame, text=_("protocol_http"), variable=proto_var, value="http").pack(side="left", padx=5)
        ttk.Radiobutton(proto_frame, text=_("protocol_https"), variable=proto_var, value="https").pack(side="left", padx=5)

        row += 1
        ttk.Label(win, text=_("ip_label")).grid(row=row, column=0, sticky="e", padx=10, pady=8)
        ttk.Entry(win, textvariable=ip_var, width=30).grid(row=row, column=1, sticky="w", padx=10, pady=8)

        row += 1
        ttk.Label(win, text=_("jnlp_label")).grid(row=row, column=0, sticky="e", padx=10, pady=8)
        ttk.Entry(win, textvariable=jnlp_var, width=30).grid(row=row, column=1, sticky="w", padx=10, pady=8)

        row += 1
        ttk.Checkbutton(
            win,
            text=_("auto_launch_label"),
            variable=auto_var,
        ).grid(row=row, column=0, columnspan=2, sticky="n", pady=8)

        row += 1
        ttk.Label(win, text=_("language_label")).grid(row=row, column=0, sticky="e", padx=10, pady=8)
        lang_combo = ttk.Combobox(win, state="readonly", values=list(_LANG_CODES.values()))
        code_to_name = {code: name for code, name in _LANG_CODES.items()}
        lang_combo.set(code_to_name.get(self.cfg.get("lang", "en"), "English"))
        lang_combo.grid(row=row, column=1, sticky="w", padx=10, pady=8)

        def on_lang_selected(event):
            selected_name = lang_combo.get()
            selected_code = {v: k for k, v in _LANG_CODES.items()}.get(selected_name, "en")
            lang_var.set(selected_code)

        lang_combo.bind("<<ComboboxSelected>>", on_lang_selected)

        row += 1
        tools_frame = ttk.Frame(win)
        tools_frame.grid(row=row, column=0, columnspan=2, pady=12, padx=10, sticky="ew")
        ttk.Button(tools_frame, text=_("import_btn"),
                   command=self.import_config, style="Small.TButton").pack(side="left", padx=5)
        ttk.Button(tools_frame, text=_("export_btn"),
                   command=self.export_config, style="Small.TButton").pack(side="left", padx=5)

        # Logs folder button
        ttk.Button(tools_frame, text="Logs Folder",
                   command=lambda: subprocess.Popen(["xdg-open", LOGS_DIR]),
                   style="Small.TButton").pack(side="left", padx=5)

        ttk.Button(tools_frame, text=_("view_logs_btn"),
                   command=self.open_log_viewer, style="Small.TButton").pack(side="right", padx=5)

        def save_and_close():
            self.cfg["auto_launch"] = auto_var.get()
            self.cfg["lang"] = lang_var.get()
            self.auto_cancel = False
            save_config(self.cfg)
            self.apply_theme(self.cfg.get("theme", self.current_theme))
            win.grab_release()
            win.destroy()

        def cancel_and_close():
            self.cfg = old_cfg
            if not self.is_launching:
                self.connect_btn.configure(text=self.get_connect_text())
            win.grab_release()
            win.destroy()

        win.protocol("WM_DELETE_WINDOW", cancel_and_close)

        row += 1
        btn_frame = ttk.Frame(win)
        btn_frame.grid(row=row, column=0, columnspan=2, pady=(5, 15))
        ttk.Button(btn_frame, text=_("save_btn"), width=10,
                   command=save_and_close, style="Small.TButton").pack(side="left", padx=8)
        ttk.Button(btn_frame, text=_("cancel_btn"), width=10,
                   command=cancel_and_close, style="Small.TButton").pack(side="left", padx=8)

        win.update_idletasks()
        rx = self.root.winfo_x() + (self.root.winfo_width() // 2) - (win.winfo_width() // 2)
        ry = self.root.winfo_y() + (self.root.winfo_height() // 2) - (win.winfo_height() // 2)
        win.geometry(f"+{rx}+{ry}")

    # Monitor Java WebStart process and close launcher when it ends
    def _watch_ows_lifecycle(self) -> None:
        if self.ows_process:
            self.ows_process.wait()
        self.root.after(0, self.on_close)

    # Launch Java WebStart with the target URL
    def launch_javaws(self) -> None:
        if self.is_launching:
            return

        self.is_launching = True
        self.cancel_auto_connect()
        self.connect_btn.configure(text=_("launching_msg"), state="disabled")
        self.root.update_idletasks()

        javaws_bin = shutil.which("javaws") or "javaws"
        target_url = self.get_target_url()
        self.log(f"Launching Java WebStart target: {target_url}")

        try:
            self.ows_process = subprocess.Popen(
                [javaws_bin, target_url],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
            )
            # Capture stderr for logs
            def capture_err():
                for line in self.ows_process.stderr:
                    self.log(f"javaws: {line.rstrip()}")
            threading.Thread(target=capture_err, daemon=True).start()

            self.root.withdraw()
            threading.Thread(target=self._watch_ows_lifecycle, daemon=True).start()
        except Exception as e:
            self.is_launching = False
            self.log(f"Launch failed: {str(e)}")
            self.root.deiconify()
            self.connect_btn.configure(text=self.get_connect_text(), state="normal")
            self.apply_theme(self.current_theme)
            messagebox.showerror(_("launch_error").split(":")[0],
                                _("launch_error").format(err=str(e)))

    # Clean shutdown (stop timers, close files, exit)
    def on_close(self) -> None:
        self.running = False

        if self.bubble_anim_job:
            try:
                self.root.after_cancel(self.bubble_anim_job)
            except Exception:
                pass
            self.bubble_anim_job = None

        if self.countdown_timer:
            try:
                self.root.after_cancel(self.countdown_timer)
            except Exception:
                pass
            self.countdown_timer = None

        try:
            self.session_log_file.close()
        except Exception:
            pass

        try:
            self.root.destroy()
        except Exception:
            pass
        sys.exit(0)


# ----------------------------------------------------------------------
# Entry‑point
# ----------------------------------------------------------------------
if __name__ == "__main__":
    # Verify prerequisites – launch installer if missing
    if not check_prerequisites():
        run_prerequisite_installer()
        sys.exit(0)

    # Launch main UI
    root = tk.Tk()
    set_ui_scaling(root)                # ensure proper DPI scaling before UI creation
    app = SplashScreen(root)
    root.mainloop()
