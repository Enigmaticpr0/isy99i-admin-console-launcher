def _(key: str, **fmt) -> str:
    """Return the translation for *key* in the current language."""
    cfg = load_config()
    lang = cfg.get("lang", "en")
    txt = _TRANSLATIONS.get(lang, _TRANSLATIONS["en"]).get(key, _TRANSLATIONS["en"].get(key, key))
    if fmt:
        try:
            txt = txt.format(**fmt)
        except Exception:
            pass
    return txt


# Load configuration (defaults merged with file data)
def load_config() -> dict:
    cfg = {
        "theme": "Frutiger Aero",
        "protocol": "http",
        "ip": "192.168.1.200",
        "jnlp": "admin.jnlp",
        "auto_launch": False,
        "lang": "en",
        "keep_logs": 10,
    }
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    cfg.update(data)
        except Exception:
            pass
    if cfg.get("protocol") not in ("http", "https"):
        cfg["protocol"] = "http"
    if cfg.get("lang") not in _LANG_CODES:
        cfg["lang"] = "en"
    try:
        cfg["keep_logs"] = max(1, int(cfg.get("keep_logs", 10)))
    except Exception:
        cfg["keep_logs"] = 10
    return cfg


# Save configuration to file
def save_config(cfg: dict) -> None:
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w") as f:
            json.dump(cfg, f, indent=2)
    except Exception:
        pass


# Send desktop notification (Linux only)
def send_desktop_notification(title: str, message: str) -> None:
    try:
        subprocess.Popen(
            ["notify-send", "-u", "critical", "-a", "Admin Console", title, message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


# Return Java version string or None
def _java_version_output() -> str | None:
    java_bin = shutil.which("java")
    if not java_bin:
        return None
    try:
        result = subprocess.run(
            [java_bin, "-version"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=5,
        )
        return result.stderr.splitlines()[0] if result.stderr else None
    except Exception:
        return None


# Detect Java 8 presence
def _has_java8() -> bool:
    out = _java_version_output()
    if not out:
        return False
    out = out.lower()
    return ("1.8.0" in out) or re.search(r"\b8\.\d", out) is not None


# Detect OpenWebStart package presence
def _has_openwebstart_pkg() -> bool:
    try:
        result = subprocess.run(
            ["dpkg", "-s", "openwebstart"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=5,
        )
        return "status: install ok installed" in result.stdout.lower()
    except Exception:
        return False


# True if both prerequisites are satisfied
def check_prerequisites() -> bool:
    return _has_java8() and _has_openwebstart_pkg()


# GitHub API URL for latest OpenWebStart release
GITHUB_API_LATEST = (
    "https://api.github.com/repos/karakun/OpenWebStart/releases/latest"
)
# Fallback .deb URL if API fails
FALLBACK_DEB_URL = (
    "https://github.com/karakun/OpenWebStart/releases/download/v1.14.0/"
    "OpenWebStart_linux_1_14_0.deb"
)


# Download latest OpenWebStart .deb to *dest_path*
def _download_latest_ows_deb(dest_path: str) -> str:
    try:
        with urllib.request.urlopen(GITHUB_API_LATEST, timeout=10) as resp:
            data = json.load(resp)
            for asset in data.get("assets", []):
                url = asset.get("browser_download_url", "")
                if url.lower().endswith(".deb"):
                    download_url = url
                    break
            else:
                raise RuntimeError("No .deb asset found in the latest release.")
    except Exception:
        download_url = FALLBACK_DEB_URL

    with urllib.request.urlopen(download_url, timeout=30) as resp, open(dest_path, "wb") as out_f:
        shutil.copyfileobj(resp, out_f)

    return dest_path


# Run a command via pkexec, return (rc, stdout, stderr)
def _run_pkexec(cmd: list[str]) -> tuple[int, str, str]:
    full_cmd = ["pkexec"] + cmd
    try:
        result = subprocess.run(
            full_cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        return result.returncode, result.stdout, result.stderr
    except Exception as e:
        return 1, "", str(e)


# Install a .deb file using pkexec
def _install_deb_via_pkexec(deb_path: str) -> None:
    ret, out, err = _run_pkexec(["dpkg", "-i", deb_path])
    if ret != 0:
        raise RuntimeError(f"dpkg installation failed:\n{out}\n{err}")

    ret, out, err = _run_pkexec(["apt-get", "-f", "install", "-y"])
    if ret != 0:
        raise RuntimeError(f"apt‑get -f install failed:\n{out}\n{err}")


# Detect screen DPI, set Tk scaling (max 1.5) and return factor
def set_ui_scaling(root: tk.Tk) -> float:
    try:
        pixels_per_inch = root.winfo_fpixels("1i")
        scaling = pixels_per_inch / 96.0
        scaling = min(scaling, 1.5)
        root.tk.call("tk", "scaling", scaling)
        return scaling
    except Exception:
        return 1.0


# Compute base font size from scaling (9 pt – 14 pt)
def base_font_size(scaling: float) -> int:
    size = int(10 * scaling)
    size = max(9, min(size, 14))
    return size


# Show a centered dialog with *title*, *message*, and an OK button
def _show_install_complete_dialog(parent: tk.Tk, title: str,
                                message: str, width: int, height: int) -> None:
    dlg = tk.Toplevel(parent)
    dlg.title(title)
    dlg.resizable(False, False)

    dlg.geometry(f"{width}x{height}")

    dlg.update_idletasks()
    x = (dlg.winfo_screenwidth() // 2) - (width // 2)
    y = (dlg.winfo_screenheight() // 2) - (height // 2)
    dlg.geometry(f"+{x}+{y}")

    msg = tk.Message(dlg, text=message, width=width - 40, justify="center")
    msg.pack(expand=True, fill="both", padx=20, pady=20)

    btn = ttk.Button(dlg, text=_("ok"), command=dlg.destroy, width=12)
    btn.pack(pady=(0, 15))
    btn.focus_set()

    dlg.transient(parent)
    dlg.grab_set()
    dlg.wait_window()


# Installer UI (language change forces restart)
def run_prerequisite_installer() -> None:
    cfg = load_config()
    missing_java = not _has_java8()
    missing_ows = not _has_openwebstart_pkg()

    missing_parts = []
    if missing_java:
        missing_parts.append(_("java_missing"))
    if missing_ows:
        missing_parts.append(_("ows_missing"))

    # Build installer UI inside *container*
    def build_ui(container: tk.Tk):
        saved_geom = container.winfo_geometry()

        for child in container.winfo_children():
            child.destroy()

        scaling = set_ui_scaling(container)
        fsize = base_font_size(scaling)

        style = ttk.Style()
        style.theme_use("clam")

        default_font = font.nametofont("TkDefaultFont")
        default_font.configure(size=fsize)
        style.configure(
            "TLabel",
            background=container["bg"],
            foreground="#000000",
            font=(default_font.cget("family"), fsize),
        )
        style.configure("TButton", font=(default_font.cget("family"), fsize))
        style.configure("TEntry", font=(default_font.cget("family"), fsize))
        style.configure("TCombobox", font=(default_font.cget("family"), fsize))
        style.configure(
            "Small.TButton",
            font=(default_font.cget("family"), max(fsize - 2, 9)),
        )
        style.map(
            "TButton",
            foreground=[("disabled", "#a0a0a0")],
            background=[("active", "#e0e0e0")],
        )

        # Language selector – saves selection and exits
        ttk.Label(container, text=_("language_label")).grid(
            row=0, column=0, sticky="e", padx=10, pady=5
        )
        lang_combo = ttk.Combobox(
            container, state="readonly", values=list(_LANG_CODES.values())
        )
        code_to_name = {code: name for code, name in _LANG_CODES.items()}
        name_to_code = {v: k for k, v in code_to_name.items()}
        lang_combo.set(code_to_name.get(cfg.get("lang", "en"), "English"))
        lang_combo.grid(row=0, column=1, sticky="w", padx=10, pady=5)

        def on_language_change(event):
            selected_name = lang_combo.get()
            selected_code = name_to_code.get(selected_name, "en")
            cfg["lang"] = selected_code
            save_config(cfg)
            messagebox.showinfo(_("installer_title"), _("restart_required"))
            container.destroy()
            sys.exit(0)

        lang_combo.bind("<<ComboboxSelected>>", on_language_change)

        # Installer description and missing components
        intro = ttk.Label(
            container,
            text=_("installer_intro"),
            font=(default_font.cget("family"), fsize, "bold"),
            anchor="center",
            justify="center",
        )
        intro.grid(row=1, column=0, columnspan=2, pady=(15, 5), padx=20, sticky="ew")

        missing_frame = ttk.Frame(container)
        missing_frame.grid(row=2, column=0, columnspan=2, pady=5, padx=30, sticky="ew")
        for part in missing_parts:
            ttk.Label(
                missing_frame,
                text=f"• {part}",
                foreground="#d00",
                font=(default_font.cget("family"), fsize),
            ).pack(anchor="w", pady=2)

        # Action buttons
        action_frame = ttk.Frame(container)
        action_frame.grid(row=3, column=0, columnspan=2, pady=15, sticky="ew", padx=20)

        status_var = tk.StringVar(value="")
        status_label = ttk.Label(container, textvariable=status_var, foreground="#006600")
        progress = ttk.Progressbar(container, mode="indeterminate")

        def enable_buttons():
            if missing_java and hasattr(container, "btn_java"):
                container.btn_java.configure(state="normal")
            if missing_ows and hasattr(container, "btn_ows"):
                container.btn_ows.configure(state="normal")
            container.btn_info.configure(state="normal")
            container.btn_quit.configure(state="normal")

        def ui_call(callback, *args, **kwargs):
            container.after(0, lambda: callback(*args, **kwargs))

        def show_info_then_quit(title: str, message: str):
            width = container.winfo_width()
            height = container.winfo_height()
            _show_install_complete_dialog(container, title, message, width, height)
            container.destroy()
            sys.exit(0)

        # Java installation thread
        def install_java_thread():
            ui_call(status_var.set, _("installing_java"))
            ui_call(progress.grid, row=4, column=0, columnspan=2, padx=20, pady=5, sticky="ew")
            ui_call(progress.start)

            ret, out, err = _run_pkexec(["apt-get", "install", "-y", "zulu8-jdk"])
            if ret != 0:
                ret, out, err = _run_pkexec(["apt-get", "install", "-y", "openjdk-8-jre"])

            ui_call(progress.stop)
            ui_call(progress.grid_remove)
            ui_call(status_label.grid_remove)

            if ret == 0:
                ui_call(show_info_then_quit, _("install_complete_java"), _("install_complete_java"))
            else:
                ui_call(messagebox.showerror, _("install_failed"), f"{out}\n{err}")
                ui_call(enable_buttons)

        # OpenWebStart installation thread
        def install_ows_thread():
            ui_call(status_var.set, _("installing_ows"))
            ui_call(progress.grid, row=4, column=0, columnspan=2, padx=20, pady=5, sticky="ew")
            ui_call(progress.start)

            try:
                deb_path = os.path.join(TMP_DIR, f"OpenWebStart_latest_{int(time.time())}.deb")
                _download_latest_ows_deb(deb_path)
            except Exception as e:
                ui_call(progress.stop)
                ui_call(progress.grid_remove)
                ui_call(status_label.grid_remove)
                ui_call(messagebox.showerror, _("download_failed"), str(e))
                ui_call(enable_buttons)
                return

            ui_call(status_var.set, _("installing_ows"))
            try:
                _install_deb_via_pkexec(deb_path)
            except Exception as e:
                ui_call(progress.stop)
                ui_call(progress.grid_remove)
                ui_call(status_label.grid_remove)
                ui_call(messagebox.showerror, _("install_failed"), str(e))
                ui_call(enable_buttons)
                try:
                    os.remove(deb_path)
                except Exception:
                    pass
                return

            try:
                os.remove(deb_path)
            except Exception:
                pass

            ui_call(progress.stop)
            ui_call(progress.grid_remove)
            ui_call(status_label.grid_remove)
            ui_call(show_info_then_quit, _("install_complete_ows"), _("install_complete_ows"))

        # Buttons for missing components
        if missing_java:
            container.btn_java = ttk.Button(
                action_frame,
                text=_("install_java"),
                command=lambda: start_thread(install_java_thread),
                width=20,
            )
            container.btn_java.pack(side="left", padx=10)

        if missing_ows:
            container.btn_ows = ttk.Button(
                action_frame,
                text=_("install_ows"),
                command=lambda: start_thread(install_ows_thread),
                width=20,
            )
            container.btn_ows.pack(side="left", padx=10)

        def open_links():
            if missing_java:
                webbrowser.open_new_tab("https://www.azul.com/downloads/?package=jdk#zulu")
            if missing_ows:
                webbrowser.open_new_tab("https://github.com/karakun/OpenWebStart/releases")

        container.btn_info = ttk.Button(
            action_frame,
            text=_("more_info"),
            command=open_links,
            width=30,
        )
        container.btn_info.pack(side="right", padx=10)

        def quit_now():
            if messagebox.askyesno(_("abort_install_title"), _("abort_install_msg")):
                ui_call(container.destroy)
                sys.exit(0)

        container.btn_quit = ttk.Button(
            container,
            text=_("quit"),
            command=quit_now,
            width=12,
        )
        container.btn_quit.grid(row=5, column=0, columnspan=2, pady=(0, 15))

        def start_thread(target):
            if missing_java and hasattr(container, "btn_java"):
                container.btn_java.configure(state="disabled")
            if missing_ows and hasattr(container, "btn_ows"):
                container.btn_ows.configure(state="disabled")
            container.btn_info.configure(state="disabled")
            container.btn_quit.configure(state="disabled")
            ui_call(status_label.grid, row=6, column=0, columnspan=2, pady=5, padx=20, sticky="ew")
            threading.Thread(target=target, daemon=True).start()

        container.protocol("WM_DELETE_WINDOW", quit_now)

        for i in range(2):
            container.columnconfigure(i, weight=1)
        for i in range(7):
            container.rowconfigure(i, weight=1)

    # Create installer window
    root = tk.Tk()
    root.title(_("installer_title"))
    root.resizable(True, True)
    root.configure(bg="#f0f0f0")

    build_ui(root)

    root.update_idletasks()
    w = root.winfo_width()
    h = root.winfo_height()
    x = (root.winfo_screenwidth() // 2) - (w // 2)
    y = (root.winfo_screenheight() // 2) - (h // 2)
    root.geometry(f"+{x}+{y}")

    root.mainloop()


# Main launcher UI
